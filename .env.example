# =============================================================================
# fleet-ai-anomaly-detection-system - example configuration
# =============================================================================
# Copy to `.env` and adjust. This file is the documented configuration surface
# of both services and is the only environment file committed to the repository.
#
# It contains NO secrets. Real credentials belong in `.env` (git-ignored) or in
# a secret manager.
#
# Values below are the MVP defaults described in docs/ARCHITECTURE.md.
# Later phases read these; no application code exists yet.
# =============================================================================


# -----------------------------------------------------------------------------
# Telemetry Service - HTTP
# -----------------------------------------------------------------------------
TELEMETRY_SERVICE_HOST=0.0.0.0
TELEMETRY_SERVICE_PORT=8000
TELEMETRY_SERVICE_VERSION=0.1.0


# -----------------------------------------------------------------------------
# Telemetry Service - MongoDB
# -----------------------------------------------------------------------------
# Local development connection string. Never commit real credentials.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fleet_telemetry
MONGODB_TELEMETRY_COLLECTION=telemetry_events

# Fail fast rather than hanging the ingest request when MongoDB is unreachable.
# Persistence failure is fail-closed for ingestion: a storage failure returns 503
# so the client's idempotent retry is the recovery mechanism (ADR-0006).
MONGODB_TIMEOUT_SECONDS=5.0


# -----------------------------------------------------------------------------
# Telemetry Service -> Inference Service
# -----------------------------------------------------------------------------
INFERENCE_SERVICE_URL=http://localhost:8001

# One attempt per ingest, bounded timeout, no in-request retries (ADR-0002).
# Inference failure is fail-open for telemetry persistence: on timeout/error the
# telemetry is still stored with inference.status = FAILED and no anomaly result
# is invented (ADR-0006).
INFERENCE_TIMEOUT_SECONDS=2.0


# -----------------------------------------------------------------------------
# Telemetry Service - time and clock-skew validation
# -----------------------------------------------------------------------------
# event_time may not be more than this far AHEAD of received_at -> CLOCK_SKEW_FUTURE.
# Small tolerance absorbs benign NTP jitter.
MAX_CLOCK_SKEW_FUTURE_SECONDS=300

# event_time may not be more than this far BEHIND received_at -> EVENT_TOO_OLD.
# Bounds the ingestion window; buffered offline flushes stay well inside it.
MAX_EVENT_AGE_DAYS=30


# -----------------------------------------------------------------------------
# Telemetry Service - query limits
# -----------------------------------------------------------------------------
# Applies to the vehicle telemetry and anomalies endpoints.
TELEMETRY_QUERY_DEFAULT_LIMIT=100
TELEMETRY_QUERY_MAX_LIMIT=1000


# -----------------------------------------------------------------------------
# Inference Service
# -----------------------------------------------------------------------------
INFERENCE_SERVICE_HOST=0.0.0.0
INFERENCE_SERVICE_PORT=8001
INFERENCE_SERVICE_VERSION=0.1.0

# joblib artifact loaded once at startup. If loading fails, /health reports
# model_loaded=false and /predict returns 503 MODEL_NOT_LOADED.
MODEL_ARTIFACT_PATH=./ml/artifacts/isolation_forest_v0_1_0.joblib

# Reported by /model/info and recorded on every scored telemetry event.
MODEL_NAME=isolation-forest-telemetry
MODEL_VERSION=0.1.0


# -----------------------------------------------------------------------------
# Logging (both services)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# `json` emits structured logs carrying event_id, vehicle_id, site_id, transport,
# inference status and latency. `text` is for local readability only.
LOG_FORMAT=json


# -----------------------------------------------------------------------------
# Telemetry Simulator
# -----------------------------------------------------------------------------
SIMULATOR_TARGET_URL=http://localhost:8000/api/v1/telemetry
SIMULATOR_VEHICLE_COUNT=5
SIMULATOR_INTERVAL_SECONDS=1.0

# IANA timezone name for simulated site-local behavior - never a fixed UTC
# offset, because offsets change at DST transitions (ADR-0004).
SIMULATOR_SITE_TIMEZONE=Asia/Taipei

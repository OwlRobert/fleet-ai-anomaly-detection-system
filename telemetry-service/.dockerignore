venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

tests/
pytest.ini

.env
.env.*
*.log
.DS_Store
.vscode/
.idea/
Dockerfile
.dockerignore
